import { transform, gfm, htmlRenderers } from "../../../web/src/index.ts";

/**
 * A live markdown editor with a rendered HTML preview.
 */
export default function Editor() {
	let $state = $watch({
		text: [
			"# Hello world",
			"",
			"Start typing _markdown_ to see it rendered live on the right.",
			"",
			"- item one",
			"- item two",
			"",
			"```js",
			"console.log('hi');",
			"```",
			"",
			"> A blockquote",
			"",
			"[a link](https://example.com)",
		].join("\n"),
		get output() {
			return transform($state.text, gfm, htmlRenderers);
		}
	});

	// TODO: fix @html and use it in the @render section
	var outputBox: HTMLDivElement;
	$mount(() => {
		const output = transform($state.text, gfm, htmlRenderers);
		if (outputBox) {
			outputBox.innerHTML = output;
		}
	});

	@render {
		<div class="editor">
			<textarea
				&value={$state.text}
				placeholder="Type markdown..."
				spellcheck="false"
			/>
			<div class="output" &ref={outputBox} style="text-align: left">
			</div>
		</div>
	}

	@style {
		.editor {
			display: flex;
			gap: 1rem;
			height: 80vh;
		}
		textarea {
			flex: 1;
			font-family: monospace;
			font-size: 14px;
			padding: 1rem;
			resize: none;
			border: 1px solid #ccc;
			border-radius: 6px;
			outline: none;
		}
		textarea:focus {
			border-color: #666;
		}
		.output {
			flex: 1;
			overflow: auto;
			padding: 1rem;
			border: 1px solid #ccc;
			border-radius: 6px;
		}
		.output :global(h1) {
			margin-top: 0;
		}
		.output :global(pre) {
			background: #f4f4f4;
			padding: 0.75rem;
			border-radius: 4px;
			overflow: auto;
		}
		.output :global(code) {
			font-family: monospace;
		}
		.output :global(blockquote) {
			margin: 0;
			padding-left: 1rem;
			border-left: 3px solid #ccc;
			color: #555;
		}
	}
}
