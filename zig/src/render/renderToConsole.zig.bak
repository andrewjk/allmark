const std = @import("std");

const MarkdownNode = @import("../types/MarkdownNode.zig").MarkdownNode;
const RuleSet = @import("../types/RuleSet.zig").RuleSet;
const RendererState = @import("../types/RendererState.zig").RendererState;
const Renderer = @import("../types/Renderer.zig").Renderer;

const ansiReset = "\x1b[0m";
const ansiBold = "\x1b[1m";
const ansiDim = "\x1b[2m";
const ansiGray = "\x1b[90m";
const ansiRed = "\x1b[31m";
const ansiGreen = "\x1b[32m";
const ansiYellow = "\x1b[33m";
const ansiBlue = "\x1b[34m";
const ansiMagenta = "\x1b[35m";
const ansiCyan = "\x1b[36m";

const consoleBullets = [4][]const u8{
    "•",
    "◦",
    "▪",
    "‣",
};

const ConsoleRendererState = struct {
    allocator: std.mem.Allocator,
    renderers: std.StringHashMap(*const Renderer),
    output: std.ArrayList(u8),
    footnotes: std.ArrayList(*const MarkdownNode),
    depth: usize = 0,
    quoteDepth: usize = 0,
};

pub fn renderToConsole(allocator: std.mem.Allocator, doc: *const MarkdownNode, rules: RuleSet) ![]const u8 {
    var state = ConsoleRendererState{
        .allocator = allocator,
        .renderers = getConsoleRenderers(allocator, rules.renderers),
        .output = std.ArrayList(u8).initCapacity(allocator, 4096) catch unreachable,
        .footnotes = std.ArrayList(*const MarkdownNode).initCapacity(allocator, 8) catch unreachable,
        .depth = 0,
        .quoteDepth = 0,
    };
    defer state.output.deinit(allocator);
    defer state.footnotes.deinit(allocator);
    defer {
        var iter = state.renderers.iterator();
        while (iter.next()) |entry| {
            allocator.free(entry.key_ptr.*);
        }
    }

    try renderChildrenConsole(doc, &state, true);

    if (state.output.items.len > 0 and state.output.items[state.output.items.len - 1] == '\n') {
        _ = state.output.pop();
    }

    return state.output.toOwnedSlice(allocator);
}

fn renderChildrenConsole(node: *const MarkdownNode, state: *ConsoleRendererState, decode: bool) !void {
    if (node.children) |children| {
        if (children.len > 0) {
            const trim = !std.mem.eql(u8, node.type, "code_block") and
                !std.mem.eql(u8, node.type, "code_fence") and
                !std.mem.eql(u8, node.type, "code_span");

            for (children, 0..) |child, i| {
                const first = i == 0;
                const last = i == children.len - 1;
                try renderNodeConsole(child, state, if (trim) first else false, if (trim) last else false, decode);
            }
        }
        }
    }
    
    fn makeLine(left: []const u8, mid: []const u8, right: []const u8, sep: []const u8) ![]const u8 {
        var line = try std.ArrayList(u8).initCapacity(state.allocator, 128);
        defer line.deinit(state.allocator);

        try line.appendSlice(allocator, left);
        {
            var i: usize = 0;
            while (i < maxColumns) : (i += 1) {
                var j: usize = 0;
                while (j < columnWidths[i]) : (j += 1) {
                    try line.appendNTimes(allocator, '─', columnWidths[i]);
                }
                if (i < maxColumns - 1) {
                    try line.appendSlice(allocator, sep);
                }
            }
        }
        try line.appendSlice(allocator, right);

        const result = try line.toOwnedSlice(allocator);
        return result;
    }

    try state.output.appendSlice(allocator, ansiDim);
    try state.output.appendSlice(allocator, makeLine("┌", "┬", "┐", "┼"));
    try state.output.appendSlice(allocator, ansiReset);
    try state.output.append(allocator, '\n');

    if (headerCells.len > 0) {
        try state.output.appendSlice(allocator, ansiDim);
        try state.output.append(allocator, "│");
        try state.output.appendSlice(allocator, ansiReset);
        
        {
            var i: usize = 0;
            while (i < headerCells.len) : (i += 1) {
                const text = if (cellTexts.items.len > 0 and i < cellTexts.items[0].items.len)
                    cellTexts.items[0].items[i]
                else 
                    "";
                const padding = try std.fmt.allocPrint(state.allocator, "{s}", .{[_]const u8{0} ** (columnWidths[i] - text.len - 1)});
                defer state.allocator.free(padding);
                
                try state.output.append(allocator, ' ');
                try state.output.appendSlice(allocator, text);
                try state.output.appendSlice(allocator, padding);
                try state.output.appendSlice(allocator, ansiDim);
                try state.output.append(allocator, "│");
                try state.output.appendSlice(allocator, ansiReset);
            }
        }
        try state.output.append(allocator, '\n');
    }

    try state.output.appendSlice(allocator, ansiDim);
    try state.output.appendSlice(allocator, makeLine("├", "┼", "┤", "┼"));
    try state.output.appendSlice(allocator, ansiReset);
    try state.output.append(allocator, '\n');

    {
        var r: usize = 0;
        while (r < dataRows.len) : (r += 1) {
            try state.output.appendSlice(allocator, ansiDim);
            try state.output.append(allocator, "│");
            try state.output.appendSlice(allocator, ansiReset);
            
            {
                var c: usize = 0;
                while (c < maxColumns) : (c += 1) {
                    const text = if (r + 1 < cellTexts.items.len and c < cellTexts.items[r + 1].items.len)
                        cellTexts.items[r + 1].items[c]
                    else 
                        "";
                    const padding = try std.fmt.allocPrint(state.allocator, "{s}", .{[_]const u8{0} ** (columnWidths[c] - text.len - 1)});
                    defer state.allocator.free(padding);
                    
                    try state.output.append(allocator, ' ');
                    try state.output.appendSlice(allocator, text);
                    try state.output.appendSlice(allocator, padding);
                    try state.output.appendSlice(allocator, ansiDim);
                    try state.output.append(allocator, "│");
                    try state.output.appendSlice(allocator, ansiReset);
                }
            }
            try state.output.append(allocator, '\n');
        }
    }

    try state.output.appendSlice(allocator, ansiDim);
    try state.output.appendSlice(allocator, makeLine("└", "┴", "┘", "┴"));
    try state.output.appendSlice(allocator, ansiReset);
}

fn getTextFromNode(node: *const MarkdownNode, allocator: std.mem.Allocator) ![]const u8 {
    if (std.mem.eql(u8, node.type, "text")) {
        return try allocator.dupe(u8, node.markup);
    }
    
    if (node.children) |children| {
        var result = try std.ArrayList(u8).initCapacity(allocator, 128);
        defer result.deinit(allocator);
        
        for (children) |child| {
            const text = try getTextFromNode(child, allocator);
            defer allocator.free(text);
            try result.appendSlice(allocator, text);
        }
        
        return result.toOwnedSlice(allocator);
    }
    
    return "";
}

fn consoleHtmlRenderer(node: *const MarkdownNode, state: *ConsoleRendererState, first: ?bool, last: ?bool, decode: ?bool) !void {
    _ = first;
    _ = last;
    _ = decode;

    try state.output.appendSlice(allocator, node.content);
}
